# Application
APP_NAME=AI Meeting Assistant
DEBUG=True

# Database — leave blank for the local SQLite file
DATABASE_URL=

# Security
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# AI models
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:7b handles Urdu and mixed Urdu-English far better than llama3.2:3b.
# Pull it once with: ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b

# Whisper. "small" is the realistic floor for Urdu; "base" mangles it.
# Use "medium" only with a GPU or a lot of patience.
WHISPER_MODEL=small
WHISPER_CPU_THREADS=4
# Blank or "auto" detects Urdu vs English per meeting and then locks onto it.
# Set "ur" or "en" to force one language.
WHISPER_LANGUAGE=

# ---------------------------------------------------------------------------
# Meeting bot
# ---------------------------------------------------------------------------
# The assistant joins Zoom and Google Meet through its own Chromium browser.
# No Zoom Marketplace app, OAuth, or RTMS webhook is used or needed.
BOT_DISPLAY_NAME=Ava Notetaker
BOT_HEADLESS=False
BOT_JOIN_TIMEOUT_SECONDS=90
BOT_UI_TIMEOUT_SECONDS=20
# Virtual audio cable device names — see docs/browser-bot-setup.md and run
# `python backend/scripts/list_audio_devices.py` to get the exact strings.
BOT_MIC_CAPTURE_DEVICE=
BOT_SPEAKER_PLAYBACK_DEVICE=
# The recording side of that same cable. The bot's browser is pinned to it as
# its microphone, so the meeting hears the assistant's spoken replies instead
# of whatever the Windows default microphone is. Must be a device Windows
# lists under Recording (WASAPI) — e.g. CABLE Output (VB-Audio Virtual Cable).
BOT_VIRTUAL_MIC_LABEL=
# Attach mode ("I'll join — assistant just listens"):
#   loopback = capture whatever plays on the speakers/headphones you already
#              hear the meeting on. No Windows/Zoom audio settings to change.
#   cable    = capture from BOT_MIC_CAPTURE_DEVICE instead.
BOT_CAPTURE_MODE=loopback
BOT_LOOPBACK_DEVICE=
# Loopback carries only the other participants, so your own mic is captured and
# mixed in too. BOT_MIC_INPUT_DEVICE = the mic you speak into (blank = default).
BOT_MIX_MIC=true
BOT_MIC_INPUT_DEVICE=

# "chrome" uses the installed Google Chrome (Zoom flags the bundled Chromium as
# a bot far more often). Set "chromium" to force Playwright's bundled build.
BOT_BROWSER_CHANNEL=chrome
# Path to a Chrome user-data dir that is already signed into the Zoom and/or
# Google account the assistant should use. Required for meetings that show
# "Sign in to join". Leave blank to join meetings as an anonymous guest.
BOT_BROWSER_PROFILE_DIR=

# Optional higher-quality TTS for the assistant's in-meeting voice
PIPER_PATH=
PIPER_MODEL=

# Admin
ADMIN_EMAILS=admin@example.com

# ---------------------------------------------------------------------------
# Task notifications
# ---------------------------------------------------------------------------
# Assignees always get an in-app notification. Set SMTP_HOST to also email
# them the task, its deadline and a calendar invite. Gmail: smtp.gmail.com,
# port 587, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Link used in emails
FRONTEND_URL=http://localhost:3000
# Remind the assignee this many hours before a deadline
TASK_REMINDER_HOURS=24
# How often the server checks deadlines (seconds); 0 turns reminders off
TASK_REMINDER_SWEEP_SECONDS=300

